#!/usr/bin/env bash
# AppImage entrypoint. Everything runs from a read-only squashfs mount, so
# every path is relative to $APPDIR.
set -euo pipefail

APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
PY="$APPDIR/usr/bin/python3"

# libVLC's set_xwindow needs a real X11 window handle, which a native Wayland
# Qt session does not hand out. A no-op on X11, since xcb is the default there.
# Defaulted rather than forced so it can still be overridden.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"

# A KDE session exports these pointing at the host's Qt 6. The bundled Qt
# loading host plugins mixes ABIs and crashes on startup. QT_QPA_PLATFORMTHEME
# is here for a different reason: a GNOME target sets it to gtk3, and Qt would
# load a gtk3 theme plugin against the host's GTK stack. That is styling loss
# and stderr noise rather than a crash, but it is avoidable.
unset QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QML2_IMPORT_PATH \
      QT_QPA_PLATFORMTHEME

export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# A bundle must run its own code. Python otherwise puts the working directory
# on sys.path ahead of the bundled site-packages, so launching from a source
# checkout silently runs the checkout instead of the AppImage.
export PYTHONSAFEPATH=1

# PYTHONSAFEPATH covers the working directory and nothing else. User site
# packages are still enabled, and ~/.local/lib/python3.13/site-packages sorts
# ahead of the bundle's own site-packages; PYTHONPATH is still honored too.
# A user with their own PyQt6 in either place would shadow the bundled one
# with a mismatched ABI. PYTHONHOME would repoint the interpreter entirely.
export PYTHONNOUSERSITE=1
unset PYTHONPATH PYTHONHOME

# libVLC is deliberately not bundled. Without this the failure surfaces deep
# in the import graph and a desktop-menu launch shows nothing on screen.
#
# The probe calls loot_player.vlc_check.libvlc_available rather than inlining
# its own `import vlc; vlc.libvlc_get_version()`. Two copies of one probe means
# the copy that ships is the copy with no test coverage. vlc_check imports only
# os and sys at module scope, so routing through it costs nothing at startup.
# (It calls a libvlc symbol rather than just importing vlc because `import vlc`
# succeeds with no VLC installed at all: vlc.py falls back to
# ctypes.CDLL(None), which is dlopen(NULL) and returns the main program's
# symbol table instead of raising.)
if ! "$PY" -c "from loot_player.vlc_check import libvlc_available; raise SystemExit(0 if libvlc_available() else 1)" >/dev/null 2>&1; then
    exec "$PY" -m loot_player.vlc_check
fi

exec "$PY" -m loot_player "$@"
